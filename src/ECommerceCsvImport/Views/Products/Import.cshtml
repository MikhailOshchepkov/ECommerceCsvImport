@model ImportViewModel
@{
    ViewData["Title"] = "Импорт товаров";
}

<h1 class="mb-4">Импорт товаров из CSV</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Импорт по пути к файлу</div>
            <div class="card-body">
                <form method="post" asp-controller="Products" asp-action="Import">
                    <div class="mb-3">
                        <label for="filePath" class="form-label">Путь к CSV-файлу</label>
                        <input type="text" class="form-control" id="filePath" name="filePath"
                               value="@Model.FilePath" placeholder="/csv/sample_products.csv" />
                        <div class="form-text">
                            Путь относительно wwwroot (например, <code>/csv/sample_products.csv</code>)
                            или полный путь на диске (например, <code>C:\data\products.csv</code>).
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Импортировать товары</button>
                </form>

                @if (Model.SampleFiles.Count > 0)
                {
                    <div class="mt-3">
                        <div class="small text-muted mb-1">Примеры файлов (нажмите, чтобы подставить путь):</div>
                        @foreach (var sample in Model.SampleFiles)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1 sample-file"
                                    data-path="@sample">@sample</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Загрузка файла через браузер</div>
            <div class="card-body">
                <form method="post" asp-controller="Products" asp-action="Upload" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="file" class="form-label">Выберите CSV-файл</label>
                        <input type="file" class="form-control" id="file" name="file" accept=".csv,text/csv" />
                        <div class="form-text">
                            Кодировка UTF-8 или Windows-1251, разделитель: запятая, точка с запятой или табуляция.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Загрузить и импортировать</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.Result != null)
{
    var result = Model.Result;

    <h2 class="mt-5 mb-3">Результат импорта</h2>

    @if (Model.SourceName != "")
    {
        <p class="text-muted mb-2">
            Источник: <code>@Model.SourceName</code>
            @if (result.EncodingName != "")
            {
                <span> · кодировка: @result.EncodingName</span>
            }
            <span> · разделитель: «@(result.Delimiter == '\t' ? "табуляция" : result.Delimiter.ToString())»</span>
        </p>
    }

    <div class="alert @(result.ErrorCount == 0 ? "alert-success" : (result.ImportedCount > 0 ? "alert-warning" : "alert-danger"))">
        @if (result.ErrorCount == 0)
        {
            <span>Импорт выполнен успешно.</span>
        }
        else if (result.ImportedCount > 0)
        {
            <span>Импорт выполнен частично: некорректные строки пропущены.</span>
        }
        else
        {
            <span>Товары не импортированы.</span>
        }
    </div>

    <table class="table table-bordered w-auto result-table">
        <thead class="table-light">
            <tr>
                <th>Показатель</th>
                <th>Значение</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Всего строк</td>
                <td id="total-rows">@result.TotalRows</td>
            </tr>
            <tr>
                <td>Успешно импортировано</td>
                <td id="imported-count">@result.ImportedCount</td>
            </tr>
            <tr>
                <td>Ошибки</td>
                <td id="error-count">@result.ErrorCount</td>
            </tr>
        </tbody>
    </table>

    @if (result.Errors.Count > 0)
    {
        <h3 class="h4 mt-4">Список ошибок</h3>

        <table class="table table-bordered table-sm errors-table">
            <thead class="table-light">
                <tr>
                    <th style="width: 100px">Строка</th>
                    <th>Описание ошибки</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in result.Errors)
                {
                    <tr>
                        <td>@(error.RowNumber == ImportConstants.FileErrorRowNumber ? "—" : error.RowNumber.ToString())</td>
                        <td>@error.Message</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-action="Index" class="btn btn-success">Перейти к списку товаров</a>
}

@section Scripts {
    <script>
        document.querySelectorAll('.sample-file').forEach(function (button) {
            button.addEventListener('click', function () {
                document.getElementById('filePath').value = button.dataset.path;
            });
        });
    </script>
}
