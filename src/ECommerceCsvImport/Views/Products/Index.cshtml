@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Список товаров";
}

<div class="page-title">
    <div>
        <h1>Товары</h1>
        <p>Оборудование, загруженное из CSV-файла в память приложения</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-main">Импортировать товары</a>
        @if (Model.AllProductsCount > 0)
        {
            <a asp-action="Export" class="btn btn-light-border">Экспорт в CSV</a>
            <form method="post" asp-action="Clear" onsubmit="return confirm('Удалить все товары из памяти?');">
                <button type="submit" class="btn btn-danger-text">Очистить</button>
            </form>
        }
    </div>
</div>

@if (Model.AllProductsCount == 0)
{
    <div class="message info">
        Товаров пока нет. Перейдите на страницу <a asp-action="Import">импорта</a> и загрузите CSV-файл.
    </div>
}
else
{
    <div class="stats">
        <div class="stat">
            <div class="stat-label">Всего товаров</div>
            <div class="stat-value" id="total-count">@Model.TotalCount</div>
            @if (Model.TotalCount != Model.AllProductsCount)
            {
                <div class="stat-label">из @Model.AllProductsCount</div>
            }
        </div>
        <div class="stat orange">
            <div class="stat-label">Общая стоимость (сумма цен)</div>
            <div class="stat-value">@Model.TotalValue.ToString("N0") ₽</div>
        </div>
        <div class="stat green">
            <div class="stat-label">Единиц на складе</div>
            <div class="stat-value">@Model.TotalStockQuantity</div>
        </div>
        <div class="stat">
            <div class="stat-label">Стоимость остатков</div>
            <div class="stat-value">@Model.TotalStockValue.ToString("N0") ₽</div>
        </div>
    </div>

    <form method="get" asp-action="Index" class="panel row g-2 align-items-end mx-0">
        <div class="col-md-4">
            <label for="search" class="form-label small">Поиск по названию</label>
            <input type="text" class="form-control" id="search" name="search" value="@Model.Search" placeholder="Например, Movix" />
        </div>
        <div class="col-md-3">
            <label for="category" class="form-label small">Категория</label>
            <select class="form-select" id="category" name="category">
                <option value="">Все категории</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.Category)">@category</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label for="sort" class="form-label small">Сортировка</label>
            <select class="form-select" id="sort" name="sort">
                <option value="" selected="@(Model.Sort == null)">Порядок импорта</option>
                <option value="name" selected="@(Model.Sort == "name")">По названию</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Цена по возрастанию</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Цена по убыванию</option>
                <option value="stock_asc" selected="@(Model.Sort == "stock_asc")">Остаток по возрастанию</option>
                <option value="stock_desc" selected="@(Model.Sort == "stock_desc")">Остаток по убыванию</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-main flex-grow-1">Применить</button>
            <a asp-action="Index" class="btn btn-light-border" title="Сбросить фильтры">✕</a>
        </div>
    </form>

    @if (Model.Products.Count == 0)
    {
        <div class="message warn">По заданным условиям товары не найдены.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table products-table">
                <thead>
                    <tr>
                        <th>Артикул</th>
                        <th>Название и описание</th>
                        <th>Категория</th>
                        <th>Бренд</th>
                        <th>Модель</th>
                        <th class="num">Цена</th>
                        <th class="num">Остаток</th>
                        <th class="num">Гарантия</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td class="sku">@product.Sku</td>
                            <td>
                                <a class="product-name" asp-action="Details" asp-route-id="@product.Sku">@product.Name</a>
                                @if (product.Description != "")
                                {
                                    <div class="description">@product.Description</div>
                                }
                            </td>
                            <td><span class="tag">@product.CategoryName</span></td>
                            <td>@product.Brand</td>
                            <td>@product.ModelNumber</td>
                            <td class="num"><b>@product.Price.ToString("N0")</b> @product.Currency</td>
                            <td class="num">@product.StockQuantity шт.</td>
                            <td class="num">@product.WarrantyMonths мес.</td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="status on">В продаже</span>
                                }
                                else
                                {
                                    <span class="status">Снят</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
