@model Product
@{
    ViewData["Title"] = Model.Name;
}

<p class="hint mt-0 mb-2"><a asp-action="Index">Товары</a> / @Model.CategoryName</p>

<div class="page-title">
    <div>
        <h1>@Model.Name</h1>
        <p>
            Артикул <span class="sku">@Model.Sku</span> ·
            @if (Model.IsActive)
            {
                <span class="status on">В продаже</span>
            }
            else
            {
                <span class="status">Снят с продажи</span>
            }
        </p>
    </div>
    <div class="price-big">@Model.Price.ToString("N2") @Model.Currency</div>
</div>

<div class="details mb-4">
    <div class="key">Описание</div>
    <div>@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</div>
    <div class="key">Категория</div>
    <div><span class="tag">@Model.CategoryName</span></div>
    <div class="key">Бренд</div>
    <div>@Model.Brand</div>
    <div class="key">Модель</div>
    <div>@(string.IsNullOrEmpty(Model.ModelNumber) ? "—" : Model.ModelNumber)</div>
    <div class="key">Остаток на складе</div>
    <div>@Model.StockQuantity шт.</div>
    <div class="key">Гарантия</div>
    <div>@Model.WarrantyMonths мес.</div>
    <div class="key">Изображение</div>
    <div>@(string.IsNullOrEmpty(Model.ImageUrl) ? "—" : Model.ImageUrl)</div>
</div>

<a asp-action="Index" class="btn btn-light-border">← К списку товаров</a>
