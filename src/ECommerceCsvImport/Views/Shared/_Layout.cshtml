<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Импорт товаров</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ECommerceCsvImport.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // Какой пункт меню подсветить
        string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        bool isImportPage = action == "Import" || action == "ImportPost" || action == "Upload";
    }
    <header class="site-header">
        <div class="container">
            <a class="logo" asp-controller="Products" asp-action="Index">
                <span class="logo-mark">ЭР</span>
                <span>
                    <span class="logo-title d-block">Каталог оборудования</span>
                    <span class="logo-subtitle">ЭР-Телеком · импорт товаров из CSV</span>
                </span>
            </a>
            <ul class="main-menu">
                <li><a class="@(isImportPage ? "" : "active")" asp-controller="Products" asp-action="Index">Товары</a></li>
                <li><a class="@(isImportPage ? "active" : "")" asp-controller="Products" asp-action="Import">Импорт</a></li>
            </ul>
        </div>
    </header>

    <main role="main" class="container">
        @if (TempData["Message"] != null)
        {
            <div class="message ok">@TempData["Message"]</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            Модуль импорта товаров из CSV · АО «ЭР-Телеком Холдинг» · ПП.02.01 · Ощепков М.А., ИПо-42
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
